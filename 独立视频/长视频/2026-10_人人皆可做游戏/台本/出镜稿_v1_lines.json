[
 {
  "id": "N01",
  "scene": "S01",
  "zh": "15 章剧情，600 多句台词，1 万多行代码。",
  "tag": ""
 },
 {
  "id": "N02",
  "scene": "S01",
  "zh": "这个银魂游戏，我一行代码都没写。",
  "tag": "⚠"
 },
 {
  "id": "N03",
  "scene": "S01",
  "zh": "从开工到 15 章全部测完，不到 20 个小时。",
  "tag": ""
 },
 {
  "id": "N04",
  "scene": "S01",
  "zh": "上一期的先导预告，抖音放了 1 万 2。",
  "tag": "⚠"
 },
 {
  "id": "N05",
  "scene": "S01",
  "zh": "真能玩吗？怎么做出来的？",
  "tag": ""
 },
 {
  "id": "N06",
  "scene": "S01",
  "zh": "今天先实机玩给你看，再从头拆。",
  "tag": ""
 },
 {
  "id": "N07",
  "scene": "S01",
  "zh": "最后，说一件比游戏更大的事。",
  "tag": ""
 },
 {
  "id": "N08",
  "scene": "S02",
  "zh": "这游戏，是从一条视频长出来的。",
  "tag": ""
 },
 {
  "id": "N09",
  "scene": "S02",
  "zh": "9 月 25 号，我让 Claude 做了一条像素动画。",
  "tag": ""
 },
 {
  "id": "N10",
  "scene": "S02",
  "zh": "B 站标题叫“300 秒看完《银魂》”。",
  "tag": ""
 },
 {
  "id": "N11",
  "scene": "S02",
  "zh": "提示词就一句：像素风，银魂的经典场景，按顺序讲故事。",
  "tag": ""
 },
 {
  "id": "N12",
  "scene": "S02",
  "zh": "它自己拆成 15 个场景，画了 42 个角色。",
  "tag": ""
 },
 {
  "id": "N13",
  "scene": "S02",
  "zh": "配乐和音效，全是代码合成的。",
  "tag": ""
 },
 {
  "id": "N14",
  "scene": "S02",
  "zh": "2 小时 52 分钟，出片。",
  "tag": ""
 },
 {
  "id": "N15",
  "scene": "S02",
  "zh": "当时评论区就有人问：跑了多长时间？这就是答案。",
  "tag": ""
 },
 {
  "id": "N16",
  "scene": "S03",
  "zh": "先上实机。",
  "tag": ""
 },
 {
  "id": "N17",
  "scene": "S03",
  "zh": "双击一个网页就能玩，不用装任何东西。",
  "tag": ""
 },
 {
  "id": "N18",
  "scene": "S03",
  "zh": "横版剧情打斗：J 三连击，K 跳，按住 L 防御。",
  "tag": ""
 },
 {
  "id": "N19",
  "scene": "S03",
  "zh": "平时随便逛，能跟 NPC 聊天；走到特定地方，开打。",
  "tag": ""
 },
 {
  "id": "N20",
  "scene": "S03",
  "zh": "有血条，输了就从这一仗重来。",
  "tag": ""
 },
 {
  "id": "N21",
  "scene": "S03",
  "zh": "规矩是我定的，就五条。",
  "tag": ""
 },
 {
  "id": "N22",
  "scene": "S03",
  "zh": "剧情为主；能自由逛；打架要有血条。",
  "tag": ""
 },
 {
  "id": "N23",
  "scene": "S03",
  "zh": "不要装备、技能、收集；可以有解谜。",
  "tag": ""
 },
 {
  "id": "N24",
  "scene": "S04",
  "zh": "素材从哪来？全是那条视频里现成的。",
  "tag": ""
 },
 {
  "id": "N25",
  "scene": "S04",
  "zh": "可它当时，只存在 Claude 的临时文件夹里。",
  "tag": ""
 },
 {
  "id": "N26",
  "scene": "S04",
  "zh": "会话一删，1.5 GB 的工程就跟着没了。",
  "tag": ""
 },
 {
  "id": "N27",
  "scene": "S04",
  "zh": "第一步，抢救，整个拷出来。",
  "tag": ""
 },
 {
  "id": "N28",
  "scene": "S04",
  "zh": "42 个角色，每人 31 个动作，11 种表情。",
  "tag": ""
 },
 {
  "id": "N29",
  "scene": "S04",
  "zh": "烘焙成游戏能用的图集，一共 13124 帧。",
  "tag": ""
 },
 {
  "id": "N30",
  "scene": "S04",
  "zh": "背景也是代码画的，一张现成图片都没有。",
  "tag": ""
 },
 {
  "id": "N31",
  "scene": "S04",
  "zh": "游戏里拆成 1600 多张图层，远景近景分开动。",
  "tag": ""
 },
 {
  "id": "N32",
  "scene": "S04",
  "zh": "12 首 8 位配乐，80 多个音效，也是代码合成的。",
  "tag": ""
 },
 {
  "id": "N33",
  "scene": "S05",
  "zh": "素材有了，剧本呢？",
  "tag": ""
 },
 {
  "id": "N34",
  "scene": "S05",
  "zh": "原片 5 分半，一共才 80 句台词。",
  "tag": ""
 },
 {
  "id": "N35",
  "scene": "S05",
  "zh": "游戏里 600 多句，多出来的从哪来？",
  "tag": ""
 },
 {
  "id": "N36",
  "scene": "S05",
  "zh": "骨架是原片的 15 个场景，一个场景，就是一章。",
  "tag": ""
 },
 {
  "id": "N37",
  "scene": "S05",
  "zh": "当年做视频时，每个场景都有一张镜头表。",
  "tag": ""
 },
 {
  "id": "N38",
  "scene": "S05",
  "zh": "哪一秒推近，谁站哪，什么时候蹦拟声字，全记着。",
  "tag": ""
 },
 {
  "id": "N39",
  "scene": "S05",
  "zh": "做每一章之前，先回去逐个镜头研究原片。",
  "tag": ""
 },
 {
  "id": "N40",
  "scene": "S05",
  "zh": "名场面照着重做：眼睛特写，一拳打穿墙，全江户集结。",
  "tag": ""
 },
 {
  "id": "N41",
  "scene": "S05",
  "zh": "每章还有小游戏或解谜。",
  "tag": ""
 },
 {
  "id": "N42",
  "scene": "S05",
  "zh": "骑小绵羊躲路障，打柏青哥，给将军剪头发。",
  "tag": ""
 },
 {
  "id": "N43",
  "scene": "S05",
  "zh": "台词，是 Claude 按人物性格新写的。",
  "tag": ""
 },
 {
  "id": "N44",
  "scene": "S05",
  "zh": "甜党、天然卷、洞爷湖，“不是假发，是桂”。",
  "tag": ""
 },
 {
  "id": "N45",
  "scene": "S05",
  "zh": "口头禅留着，其余大多是新写的。",
  "tag": ""
 },
 {
  "id": "N46",
  "scene": "S05",
  "zh": "拿不准的设定，干脆不写。",
  "tag": ""
 },
 {
  "id": "N47",
  "scene": "S05",
  "zh": "比如序章里，高杉只被提到，没让他出场。",
  "tag": ""
 },
 {
  "id": "N48",
  "scene": "S05",
  "zh": "原片序章加第一章，一共才 37 秒。",
  "tag": ""
 },
 {
  "id": "N49",
  "scene": "S05",
  "zh": "游戏里这两章，光对话就 78 句。",
  "tag": ""
 },
 {
  "id": "N50",
  "scene": "S06",
  "zh": "再玩两段。",
  "tag": ""
 },
 {
  "id": "N51",
  "scene": "S06",
  "zh": "第一章，大街上 8 个 NPC，10 个能调查的地方。",
  "tag": ""
 },
 {
  "id": "N52",
  "scene": "S06",
  "zh": "交不上房租，得在事务所里翻钱。",
  "tag": ""
 },
 {
  "id": "N53",
  "scene": "S06",
  "zh": "沙发缝里有张字条：重要的钱，藏在你最重视的东西后面。",
  "tag": ""
 },
 {
  "id": "N54",
  "scene": "S06",
  "zh": "最重视的？“糖分”那幅字，5000 日元就在后头。",
  "tag": ""
 },
 {
  "id": "N55",
  "scene": "S06",
  "zh": "第二章，家庭餐厅。这个眼睛特写，原片里就有。",
  "tag": ""
 },
 {
  "id": "N56",
  "scene": "S06",
  "zh": "下一秒，一拳打穿墙。",
  "tag": ""
 },
 {
  "id": "N57",
  "scene": "S07",
  "zh": "代码呢？一个游戏引擎都没用。",
  "tag": ""
 },
 {
  "id": "N58",
  "scene": "S07",
  "zh": "就是浏览器自带的画布，加原生 JavaScript。",
  "tag": ""
 },
 {
  "id": "N59",
  "scene": "S07",
  "zh": "画面 384 乘 216，跟原片一样大，放大了显示。",
  "tag": ""
 },
 {
  "id": "N60",
  "scene": "S07",
  "zh": "剧情写成一行行指令：谁说话，往哪走，在哪开打。",
  "tag": ""
 },
 {
  "id": "N61",
  "scene": "S07",
  "zh": "每一章都走同样五步。",
  "tag": ""
 },
 {
  "id": "N62",
  "scene": "S07",
  "zh": "研究原片，导出场景，补角色动作，写剧情，自动通关。",
  "tag": ""
 },
 {
  "id": "N63",
  "scene": "S07",
  "zh": "自动通关最关键：开一个看不见的浏览器，自己从头玩。",
  "tag": ""
 },
 {
  "id": "N64",
  "scene": "S07",
  "zh": "推对话，走位，打架，按小游戏，边玩边截图。",
  "tag": ""
 },
 {
  "id": "N65",
  "scene": "S07",
  "zh": "最后一遍：600 多句对话，34 分钟，0 个报错。",
  "tag": ""
 },
 {
  "id": "N66",
  "scene": "S08",
  "zh": "最后看高潮。",
  "tag": ""
 },
 {
  "id": "N67",
  "scene": "S08",
  "zh": "原片的银之魂篇 32 秒，游戏里要打将近 5 分钟。",
  "tag": ""
 },
 {
  "id": "N68",
  "scene": "S08",
  "zh": "屋顶三段混战，各路人马一组组杀进来。",
  "tag": ""
 },
 {
  "id": "N69",
  "scene": "S08",
  "zh": "然后跟高杉背靠背，一路撑到天亮。",
  "tag": ""
 },
 {
  "id": "N70",
  "scene": "S08",
  "zh": "终章还有个梗：定春一口咬下去，画面变灰，跳出个“完”。",
  "tag": ""
 },
 {
  "id": "N71",
  "scene": "S08",
  "zh": "你得看准时机，一脚把“完”字踢飞。",
  "tag": ""
 },
 {
  "id": "N72",
  "scene": "S08",
  "zh": "这股整活劲儿，就是银魂的味道。",
  "tag": "我的看法"
 },
 {
  "id": "N73",
  "scene": "S09",
  "zh": "听着挺轻松？没那么简单。",
  "tag": ""
 },
 {
  "id": "N74",
  "scene": "S09",
  "zh": "第二章，我先让 GPT 写了一版。",
  "tag": ""
 },
 {
  "id": "N75",
  "scene": "S09",
  "zh": "名场面全被一句旁白带过，街坊还在说第一章的台词。",
  "tag": ""
 },
 {
  "id": "N76",
  "scene": "S09",
  "zh": "最后整章推倒重写，光这一章剧情就 931 行。",
  "tag": ""
 },
 {
  "id": "N77",
  "scene": "S09",
  "zh": "能玩，也不等于没毛病。",
  "tag": ""
 },
 {
  "id": "N78",
  "scene": "S09",
  "zh": "第十章打进第十一章，整章被白屏盖住。",
  "tag": ""
 },
 {
  "id": "N79",
  "scene": "S09",
  "zh": "序章结尾的过场，一直只有声音没画面，录屏时才发现。",
  "tag": ""
 },
 {
  "id": "N80",
  "scene": "S09",
  "zh": "也不是不花钱。",
  "tag": "可删"
 },
 {
  "id": "N81",
  "scene": "S09",
  "zh": "那条像素视频，按 API 价折算是 352 美元。",
  "tag": "可删"
 },
 {
  "id": "N82",
  "scene": "S09",
  "zh": "我用的订阅，没真掏这么多。",
  "tag": "可删"
 },
 {
  "id": "N83",
  "scene": "S09",
  "zh": "我的活就三件：定规矩，做选择，挑毛病。",
  "tag": "⚠"
 },
 {
  "id": "N84",
  "scene": "S09",
  "zh": "还有，这是同人作品，角色是空知英秋老师的。",
  "tag": ""
 },
 {
  "id": "N85",
  "scene": "S09",
  "zh": "做着玩、做来学都行，拿去卖不行。",
  "tag": ""
 },
 {
  "id": "N86",
  "scene": "S10",
  "zh": "这事，比银魂大。",
  "tag": ""
 },
 {
  "id": "N87",
  "scene": "S10",
  "zh": "我还有个游戏：无职转生，第一季 8 章。",
  "tag": ""
 },
 {
  "id": "N88",
  "scene": "S10",
  "zh": "这次连素材都没有，提示词也就一句话。",
  "tag": ""
 },
 {
  "id": "N89",
  "scene": "S10",
  "zh": "我设了个定时任务，就没再管。",
  "tag": "⚠"
 },
 {
  "id": "N90",
  "scene": "S10",
  "zh": "凌晨 1 点 25 开跑，5 点半做完，4 个小时。",
  "tag": ""
 },
 {
  "id": "N91",
  "scene": "S10",
  "zh": "55 套角色、40 张地图、16 首配乐，全靠程序生成。",
  "tag": ""
 },
 {
  "id": "N92",
  "scene": "S10",
  "zh": "引擎是拿银魂这个改的，做过一次，第二次就快多了。",
  "tag": ""
 },
 {
  "id": "N93",
  "scene": "S10",
  "zh": "所以门槛还剩什么？",
  "tag": ""
 },
 {
  "id": "N94",
  "scene": "S10",
  "zh": "以前做游戏，得会画画、会写代码、会作曲，还得有团队。",
  "tag": ""
 },
 {
  "id": "N95",
  "scene": "S10",
  "zh": "现在，你得知道自己想要什么，说得清，看得出好坏。",
  "tag": ""
 },
 {
  "id": "N96",
  "scene": "S10",
  "zh": "而且远不止游戏。",
  "tag": ""
 },
 {
  "id": "N97",
  "scene": "S10",
  "zh": "一篇强化学习长文，7000 多词，做成了一分钟视频。",
  "tag": ""
 },
 {
  "id": "N98",
  "scene": "S10",
  "zh": "一门官方课，拆成了 10 集短视频。",
  "tag": ""
 },
 {
  "id": "N99",
  "scene": "S10",
  "zh": "漫画变动画，动画变游戏，长文变视频。",
  "tag": ""
 },
 {
  "id": "N100",
  "scene": "S10",
  "zh": "一本教材、一篇论文、一部小说，都能换个样子。",
  "tag": ""
 },
 {
  "id": "N101",
  "scene": "S10",
  "zh": "换成你愿意玩的游戏，愿意看的动画，愿意刷的短视频。",
  "tag": ""
 },
 {
  "id": "N102",
  "scene": "S11",
  "zh": "以前，是人去适应知识的样子。",
  "tag": ""
 },
 {
  "id": "N103",
  "scene": "S11",
  "zh": "现在，知识可以长成你喜欢的样子。",
  "tag": ""
 },
 {
  "id": "N104",
  "scene": "S11",
  "zh": "欢迎来到，人人皆可做游戏的时代。",
  "tag": ""
 },
 {
  "id": "N105",
  "scene": "S11",
  "zh": "你最想把哪本书、哪部番做成游戏？评论区告诉我。",
  "tag": "可删"
 }
]
  },
  {
   "pid": "N06",
   "clip": "0161",
   "s": 90.28,
   "e": 93.44,
   "zh": "就像图中这样，它是一个一个像素，",
   "en": "Like in this picture, pixel by pixel,",
   "skip": [],
